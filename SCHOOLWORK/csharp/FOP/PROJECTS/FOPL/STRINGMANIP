Console.WriteLine("String Manipulation Assignment");
string str1 = "Adamson University";
Console.WriteLine();
Console.WriteLine("1. Cloning the string results in a copy of the original string: " + str1.Clone());
Console.WriteLine();
Console.WriteLine("2. ToUpper converts the entire string to uppercase: " + str1.ToUpper());
Console.WriteLine();
Console.WriteLine("3. ToLower converts the entire string to lowercase: " + str1.ToLower());
Console.WriteLine();
Console.WriteLine("4. Contains checks if the string contains a specific substring (results in a boolean expression): " + str1.Contains("University"));
Console.WriteLine();
Console.WriteLine("5. ToCharArray converts the string into a char array: " + new string(str1.ToCharArray(7, 10)));
Console.WriteLine();
Console.WriteLine("6. Substring extracts a substring from the string: " + str1.Substring(0, 7));
Console.WriteLine();
Console.WriteLine("7. StartsWith checks if the string starts with a specific substring (results in a bool expression): " + str1.StartsWith("De La Salle"));
Console.WriteLine();
Console.WriteLine("8. EndsWith checks if the string ends with a specific substring (results in a bool expression): " + str1.EndsWith("University"));
Console.WriteLine();
Console.WriteLine("9. Split splits the string into an array of substrings based on a specified delimiter: " + string.Join(", ", str1.Split(' ')));
Console.WriteLine();
Console.WriteLine("10. Replace replaces all occurrences of a specified substring with another substring: " + str1.Replace("University", "Senior High School"));
string str2 = "     messy string         ";
Console.WriteLine(str2);
Console.WriteLine("11. Trim removes all leading and trailing white-space characters from the string: " + str2.Trim());
