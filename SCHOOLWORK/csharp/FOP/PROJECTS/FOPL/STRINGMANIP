Console.WriteLine("String Manipulation Assignment");
string str1 = "Adamson University";
Console.WriteLine(str1.Clone());
Console.WriteLine();

Console.WriteLine(str1.ToUpper());
Console.WriteLine();

Console.WriteLine(str1.ToLower());
Console.WriteLine();

Console.WriteLine(str1.Contains("University"));
Console.WriteLine();

Console.WriteLine(new string(str1.ToCharArray(7, 10)));
Console.WriteLine();

Console.WriteLine(str1.Substring(0, 7));
Console.WriteLine();

Console.WriteLine(str1.StartsWith("De La Salle"));
Console.WriteLine();

Console.WriteLine(str1.EndsWith("University"));
Console.WriteLine();

Console.WriteLine(string.Join(", ", str1.Split(' ')));
Console.WriteLine();

Console.WriteLine(str1.Replace("University", "Senior High School"));
Console.WriteLine();

Console.WriteLine(str1.IndexOf("s"));
Console.WriteLine();

Console.WriteLine(str1.LastIndexOf("s"));
Console.WriteLine();

Console.WriteLine(str1.Substring(0, 6));

